# 複製成 .env(已在 .gitignore 排除,不會進 git),填入真實值。
# 不要把這個檔案的真實內容貼進聊天記錄、commit 訊息、或任何 log。

BYBIT_API_KEY=
BYBIT_API_SECRET=
REDIS_URL=
# 交易紀錄資料庫:Fa_Successful_trade docker-compose.yml 的 trading-postgres 容器(port 5434),例如:
#   postgresql+psycopg2://trading:<密碼>@localhost:5434/trading
# 密碼在 Fa_Successful_trade/.env 的 TRADING_POSTGRES_PASSWORD。
# 沒設或連不上時,實盤紀錄寫 logs/db_pending/,之後用 storage/backfill.py 補進去。
TRADING_DB_URL=
